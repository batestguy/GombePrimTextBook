    {
      "id": "P1-15-SEQUENCE-MODEL",
      "mode": "model",
      "objectives": [
        "P1-p10-01"
      ],
      "canonical_answer": "Amina: wake, wash, eat, school. First wake; wash next; school last; eating follows washing and is before school. These are this fictional story's choices, not a universal routine.",
